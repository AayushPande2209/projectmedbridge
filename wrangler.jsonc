{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectmedbridge1",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "www.projectmedbridge.org",
      "custom_domain": true
    },
    {
      "pattern": "projectmedbridge.org",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "projectmedbridge1"
    }
  ]
}
